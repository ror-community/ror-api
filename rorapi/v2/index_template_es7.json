                        "fields": {
                            "keyword": {
                                "type": "keyword"
                            },
                            "norm": {
                                "type": "text",
                                "analyzer": "string_lowercase",
                                "fielddata": true
                            }
                        },
                        "analyzer": "string_lowercase"
                    },
                    "id": {
                        "type": "keyword"
                    }
                }
            },
            "status": {
