                                "fields": {
                                    "raw": {
                                        "type": "keyword"
                                    }
                                }
                            },
                            "continent_name": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer"
                            },
                            "country_code": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer",
                                "fields": {
                                    "raw": {
                                        "type": "keyword"
                                    }
                                }
                            },
                            "country_name": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer"
                            },
                            "country_subdivision_code": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer"
                            },
                            "country_subdivision_name": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer"
                            },
                            "lat": {
                                "type": "float"
                            },
                            "lng": {
                                "type": "float"
                            },
                            "name": {
                                "type": "keyword",
                                "normalizer": "folding_normalizer"
                            }
                        }
                    }
                }
            },
            "names": {
                "properties": {
                    "value": {
